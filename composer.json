{
    "name": "michaelhairetis/mpp",
    "description": "PHP SDK for the Machine Payments Protocol (MPP)",
    "type": "library",
    "keywords": ["mpp", "payments", "http-402", "agentic", "stablecoin"],
    "homepage": "https://mpp.dev",
    "license": ["Apache-2.0", "MIT"],
    "authors": [
        {
            "name": "Michael Hairetis",
            "email": "parallel32@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "Mpp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mpp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "fmt": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
